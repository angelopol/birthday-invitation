// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BirthdayPeople {
  username   String  @id @db.VarChar(191)
  password   String
  partyDate  DateTime?
  ubication  String?
  dressCode  String?
  extraInfo  String?

  // Personalización de colores de la invitación
  primaryColor   String? // color principal (botones, acentos)
  secondaryColor String? // color secundario
  backgroundColor String? // fondo principal de la tarjeta
  typographyFamily String?
  typographySize   Int?

  // Integración con Spotify
  spotifyUserId          String?   @db.VarChar(191)
  spotifyPlaylistId      String?   @db.VarChar(191)
  spotifyAccessToken     String?   @db.Text
  spotifyRefreshToken    String?   @db.Text
  spotifyTokenExpiresAt  DateTime?

  // Fondo global de la invitación: modo (color|image|gradient) y URL de imagen opcional
  globalBackgroundMode   String?   @db.VarChar(20)
  globalBackgroundImageUrl String? @db.VarChar(512)

  guests        Guest[]
  galleryItems  PartysGallery[]
  partyTracks   PartyTrack[]
  invitationScreens InvitationScreen[]
}

model Guest {
  token            String  @id @db.VarChar(191)
  name             String  @db.VarChar(255)
  confirmated      Boolean @default(false)

  // Personalización opcional del invitado
  nickname         String? @db.VarChar(255)
  avatarUrl        String? @db.VarChar(512)

  birthdayUsername String  @db.VarChar(191)
  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])
  galleryItems     PartysGallery[]
  partyTracks      PartyTrack[]
  trackVotes       PartyTrackVote[]

  @@index([birthdayUsername])
}

model PartysGallery {
  id               Int      @id @default(autoincrement())
  fileName         String   @db.VarChar(255)
  fileType         String   @db.VarChar(50) // image|video mime category
  s3Key            String   @db.VarChar(512)
  createdAt        DateTime @default(now())

  birthdayUsername String   @db.VarChar(191)
  guestToken       String?  @db.VarChar(191)

  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])
  guest            Guest?         @relation(fields: [guestToken], references: [token])

  @@index([birthdayUsername])
  @@index([guestToken])
}

model PartyTrack {
  id               Int      @id @default(autoincrement())
  birthdayUsername String   @db.VarChar(191)
  guestToken       String?  @db.VarChar(191)
  spotifyTrackId   String   @db.VarChar(100)
  title            String   @db.VarChar(255)
  artist           String   @db.VarChar(255)
  album            String?  @db.VarChar(255)
  coverUrl         String?  @db.VarChar(512)
  previewUrl       String?  @db.VarChar(512)
  comment          String?  @db.VarChar(280)
  createdAt        DateTime @default(now())

  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])
  guest            Guest?         @relation(fields: [guestToken], references: [token])
  votes            PartyTrackVote[]

  @@index([birthdayUsername])
  @@index([guestToken])
  @@unique([birthdayUsername, spotifyTrackId])
}

model PartyTrackVote {
  id         Int      @id @default(autoincrement())
  trackId    Int
  guestToken String   @db.VarChar(191)
  createdAt  DateTime @default(now())

  track      PartyTrack @relation(fields: [trackId], references: [id])
  guest      Guest      @relation(fields: [guestToken], references: [token])

  @@unique([trackId, guestToken])
  @@index([guestToken])
}

model InvitationScreen {
  id               Int      @id @default(autoincrement())
  birthdayUsername String   @db.VarChar(191)
  order            Int      @default(0)

  // Fondo de la pantalla: imagen o color liso
  backgroundType      String   @db.VarChar(20) // 'image' | 'color'
  backgroundImageUrl  String?  @db.VarChar(512)
  backgroundColor     String?  @db.VarChar(20)

  // Distribución y contenido de la pantalla
  layoutType String  @db.VarChar(20) @default("single") // 'single' | 'split'
  content    Json?
  fragments  Json?

  birthdayPerson BirthdayPeople @relation(fields: [birthdayUsername], references: [username])

  @@index([birthdayUsername])
  @@unique([birthdayUsername, order])
}
