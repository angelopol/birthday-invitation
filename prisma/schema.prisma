// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BirthdayPeople {
  username   String  @id @db.VarChar(191)
  password   String
  partyDate  DateTime?
  ubication  String?
  dressCode  String?
  extraInfo  String?

  // Personalización de colores de la invitación
  primaryColor   String? // color principal (botones, acentos)
  secondaryColor String? // color secundario
  backgroundColor String? // fondo principal de la tarjeta

  guests        Guest[]
  galleryItems  PartysGallery[]
  partyTracks   PartyTrack[]
}

model Guest {
  token            String  @id @db.VarChar(191)
  name             String  @db.VarChar(255)
  confirmated      Boolean @default(false)

  birthdayUsername String  @db.VarChar(191)
  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])

  @@index([birthdayUsername])
}

model PartysGallery {
  id               Int      @id @default(autoincrement())
  fileName         String   @db.VarChar(255)
  fileType         String   @db.VarChar(50) // image|video mime category
  s3Key            String   @db.VarChar(512)
  createdAt        DateTime @default(now())

  birthdayUsername String   @db.VarChar(191)
  guestToken       String   @db.VarChar(191)

  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])

  @@index([birthdayUsername])
  @@index([guestToken])
}

model PartyTrack {
  id               Int      @id @default(autoincrement())
  birthdayUsername String   @db.VarChar(191)
  guestToken       String?  @db.VarChar(191)
  spotifyTrackId   String   @db.VarChar(100)
  title            String   @db.VarChar(255)
  artist           String   @db.VarChar(255)
  album            String?  @db.VarChar(255)
  coverUrl         String?  @db.VarChar(512)
  previewUrl       String?  @db.VarChar(512)
  createdAt        DateTime @default(now())

  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])

  @@index([birthdayUsername])
  @@index([guestToken])
  @@unique([birthdayUsername, spotifyTrackId])
}
