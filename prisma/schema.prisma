// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model BirthdayPeople {
  username   String  @id @db.VarChar(191)
  password   String
  partyDate  DateTime?
  ubication  String?
  dressCode  String?
  extraInfo  String?

  guests     Guest[]
}

model Guest {
  token            String  @id @db.VarChar(191)
  name             String  @db.VarChar(255)
  confirmated      Boolean @default(false)

  birthdayUsername String  @db.VarChar(191)
  birthdayPerson   BirthdayPeople @relation(fields: [birthdayUsername], references: [username])

  @@index([birthdayUsername])
}
